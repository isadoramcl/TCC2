# ---------------------------------------------------------------
# Ambiente virtual Python
# Nao versionado: e recriavel a partir de requirements.txt e contem
# binarios especificos desta maquina/sistema operacional.
# ---------------------------------------------------------------
.venv/
venv/

# ---------------------------------------------------------------
# Cache do interpretador Python
# ---------------------------------------------------------------
__pycache__/
*.pyc
*.pyo

# ---------------------------------------------------------------
# Configuracoes locais de editor
# ---------------------------------------------------------------
.vscode/
.idea/

# ---------------------------------------------------------------
# Arquivos gerados pelo sistema operacional
# ---------------------------------------------------------------
Thumbs.db
desktop.ini
.DS_Store

# ---------------------------------------------------------------
# NOTA METODOLOGICA
# data/ e outputs/ SAO versionados de proposito.
# Os dados brutos somam ~4,4 MB (texto), volume trivial para o Git,
# e mante-los no repositorio garante que qualquer replicacao parta
# exatamente dos mesmos arquivos de entrada. Se outputs/ crescer
# muito, esta decisao sera revista e o commit registrara a mudanca.
# ---------------------------------------------------------------

# Parciais das execucoes em lote: sao reconstruidos rodando os scripts com
# --rodar, e somam dezenas de MB. Os CSV CONSOLIDADOS, que alimentam o
# documento, ficam versionados.
outputs/tables/_b9_parciais/
outputs/tables/_fatorial_parciais/
outputs/tables/_tau_min_parciais/
outputs/tables/_tendencia_parciais/
outputs/tables/_orfaos/
outputs/_to_delete/

# `[AUDITORIA]` Os parciais acima sao ignorados, mas os CSV CONSOLIDADOS que
# alimentam o documento NAO sao. Em particular ficam versionados:
#   outputs/tables/modelo_12_porta2_bruto.csv  — as 768 execucoes pareadas que
#     sustentam a Tabela 13 (Porta 2). Sem ele, a analise nao seria rastreavel,
#     porque os parciais de origem estao em _b9_parciais/, que e ignorado.
#   outputs/tables/partes_hm/  — mantida, pois e a origem da Tabela 15.

# Saidas do Claude fora do lugar canonico; projeto/ e o canonico
Claude outputs/

